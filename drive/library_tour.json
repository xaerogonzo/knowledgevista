[
  {"do": "add_root", "path": "${KV_DRIVE_LIBRARY}", "label": "Drive library", "allow_organize": true},
  {"do": "wait_jobs", "within_ms": 60000},
  {"do": "expect", "id": "four documents after the scan", "check": "rows", "table": "docTable", "equals": 4},
  {"do": "expect", "id": "the scan said so", "check": "message", "contains": "Scanned 4 file(s)"},

  {"do": "extract"},
  {"do": "wait_jobs", "within_ms": 120000},
  {"do": "resolve"},
  {"do": "wait_jobs", "within_ms": 120000},
  {"do": "expect", "id": "proposals are waiting for a person", "check": "review_items", "at_least": 4},
  {"do": "expect", "id": "and the tab says how many", "check": "tab_text", "index": 2, "contains": "Review ("},

  {"do": "search", "text": "aqueous"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "the search shows its tab", "check": "tab", "equals": "search"},
  {"do": "expect", "id": "pages were found", "check": "rows", "table": "hitTable", "at_least": 3},
  {"do": "expect", "id": "and the summary names what it found", "check": "text", "widget": "searchSummary", "contains": "page(s) in"},

  {"do": "tab", "name": "documents"},
  {"do": "select", "title": "papers/aqueous.pdf"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "the detail pane follows the selection", "check": "detail_title", "equals": "papers/aqueous.pdf"},
  {"do": "expect", "id": "the title is only proposed", "check": "detail_field", "field": "Title", "contains": "1 proposed"},

  {"do": "press", "widget": "why_title"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "the evidence window opened", "check": "dialog_open", "includes": ["evidenceDialog"]},
  {"do": "expect", "id": "it names the proposed title", "check": "text", "widget": "evidenceText", "contains": "Aqueous Solubility of Invented Esters"},
  {"do": "expect", "id": "and says nothing is accepted yet", "check": "text", "widget": "evidenceText", "contains": "Unresolved: nothing is accepted yet"},
  {"do": "shot", "path": "${KV_DRIVE_SHOTS}/evidence.png", "widget": "evidenceDialog"},
  {"do": "close_dialogs"},

  {"do": "select_review", "paper": "papers/aqueous.pdf", "field": "Title"},
  {"do": "wait_jobs"},
  {"do": "press", "widget": "acceptButton"},
  {"do": "wait_jobs"},
  {"do": "tab", "name": "documents"},
  {"do": "expect", "id": "the accepted title is now the document's name", "check": "titles", "includes": ["Aqueous Solubility of Invented Esters"]},
  {"do": "expect", "id": "and the catalog agrees", "check": "catalog", "sql": "SELECT value FROM metadata_value WHERE field = 'title' AND accepted_by = 'user'", "equals": "Aqueous Solubility of Invented Esters"},

  {"do": "select", "title": "Aqueous Solubility of Invented Esters"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "the badge says it was read from the file", "check": "detail_field", "field": "Title", "column": "source", "equals": "O"},

  {"do": "press", "widget": "renameButton"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "the rename proposal opened", "check": "dialog_open", "includes": ["renameDialog"]},
  {"do": "expect", "id": "and it says nothing has been renamed", "check": "text", "widget": "renameSummary", "contains": "Nothing has been renamed."},
  {"do": "shot", "path": "${KV_DRIVE_SHOTS}/rename.png", "widget": "renameDialog"},
  {"do": "close_dialogs"},
  {"do": "expect", "id": "the file is still where it was", "check": "catalog", "sql": "SELECT COUNT(*) FROM location WHERE relative_path = 'papers/aqueous.pdf' AND ended_at IS NULL", "equals": 1},

  {"do": "press", "widget": "openButton"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "the file was handed to the system viewer", "check": "shell", "kind": "open", "endswith_any": "aqueous.pdf"},
  {"do": "expect", "id": "exactly once", "check": "shell_count", "equals": 1},

  {"do": "mark", "name": "before the terminal"},
  {"do": "external", "args": ["tag", "add", "Reference", "papers/aqueous.pdf"]},
  {"do": "expect", "id": "a change made in a terminal appears without a click", "check": "sidebar_has", "includes": ["Reference  (1)"], "within_ms": 10000},
  {"do": "expect", "id": "because the revision moved", "check": "revision", "greater_than_mark": "before the terminal"},

  {"do": "tab", "name": "review"},
  {"do": "filter", "text": "aqueous"},
  {"do": "search", "text": "aqueous solubility"},
  {"do": "wait_jobs"},
  {"do": "tab", "name": "review"},
  {"do": "restart"},
  {"do": "wait_jobs"},
  {"do": "expect", "id": "after a restart the window is where it was: tab", "check": "tab", "equals": "review"},
  {"do": "expect", "id": "the filter", "check": "filter_text", "equals": "aqueous"},
  {"do": "expect", "id": "the search box", "check": "search_text", "equals": "aqueous solubility"},
  {"do": "expect", "id": "the document", "check": "detail_title", "equals": "Aqueous Solubility of Invented Esters", "within_ms": 5000},
  {"do": "expect", "id": "and the library's own state is intact: the accepted title", "check": "catalog", "sql": "SELECT COUNT(*) FROM metadata_value WHERE field = 'title'", "equals": 1},
  {"do": "expect", "id": "and the tag", "check": "sidebar_has", "includes": ["Reference  (1)"]},

  {"do": "expect", "id": "no text from outside could show as markup", "check": "text_safe"},
  {"do": "shot", "path": "${KV_DRIVE_SHOTS}/tour.png"},
  {"do": "expect_clean", "settle_ms": 800},
  {"do": "log_report"},
  {"do": "quit"}
]
